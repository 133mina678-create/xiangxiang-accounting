# Supabase project: xiangxiang-accounting
# Dashboard > Connect: Project URL (not the dashboard URL or project name).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Dashboard > Settings > API Keys: publishable key (legacy anon is also supported).
# NEVER use sb_secret_, service_role, database passwords or signing secrets here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only: Dashboard > Settings > API Keys > Secret key.
# Used only by protected Next.js Route Handlers for the private proof bucket.
# Never prefix this variable with NEXT_PUBLIC_ and never expose it in browser code.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Server only: long random value. Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace_with_at_least_32_random_characters
# Vercel only: select packageManager pnpm@11.19.0 from package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
